<?xml version="1.0" encoding="utf-8"?>
<!-- RBSB-Weather widget: the animated sky (frames) with the desktop widget's text over it.
     Created By Shane BlackbuRn -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_placeholder">
    <ViewFlipper android:id="@+id/w_frames" android:layout_width="match_parent" android:layout_height="match_parent"
        android:flipInterval="150" android:autoStart="true" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="12dp"
        android:paddingTop="9dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/w_place" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1"
                    android:ellipsize="end" android:text="RBSB-Weather"
                    android:shadowColor="#99000000" android:shadowDy="1" android:shadowRadius="3" />
                <TextView android:id="@+id/w_source" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#D9FFFFFF" android:textSize="10sp" android:maxLines="1"
                    android:shadowColor="#99000000" android:shadowDy="1" android:shadowRadius="2" />
                <TextView android:id="@+id/w_alert" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:paddingStart="5dp" android:paddingEnd="5dp"
                    android:background="#FFF28C28" android:textColor="#FF1F1300" android:textSize="10sp" android:textStyle="bold"
                    android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/w_updated" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/widget_pill" android:paddingStart="6dp" android:paddingEnd="6dp"
                android:paddingTop="1dp" android:paddingBottom="1dp"
                android:textColor="#EBFFFFFF" android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="34sp" android:textStyle="bold" android:text="–"
            android:includeFontPadding="false"
            android:shadowColor="#99000000" android:shadowDy="2" android:shadowRadius="5" />
        <TextView android:id="@+id/w_condition" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"
            android:shadowColor="#99000000" android:shadowDy="1" android:shadowRadius="3" />
        <TextView android:id="@+id/w_hilo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#E6FFFFFF" android:textSize="12sp" android:maxLines="1"
            android:shadowColor="#99000000" android:shadowDy="1" android:shadowRadius="3" />
    </LinearLayout>
</FrameLayout>

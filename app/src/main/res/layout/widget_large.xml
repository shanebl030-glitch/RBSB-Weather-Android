<?xml version="1.0" encoding="utf-8"?>
<!-- RBSB-Weather large widget (with the next five days). Created By Shane BlackbuRn -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg_day">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/w_place" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" android:maxLines="1"
                android:ellipsize="end" android:text="RBSB-Weather" />
            <TextView android:id="@+id/w_condition" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_hilo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF" android:textSize="12sp" android:maxLines="1" />
            <TextView android:id="@+id/w_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF" android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/w_symbol" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="34sp" android:text="🌤️" />
        <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textColor="#FFFFFFFF" android:textSize="40sp" android:textStyle="bold"
            android:text="–" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/day0_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/day0_sym" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" />
            <TextView android:id="@+id/day0_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/day1_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/day1_sym" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" />
            <TextView android:id="@+id/day1_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/day2_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/day2_sym" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" />
            <TextView android:id="@+id/day2_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/day3_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/day3_sym" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" />
            <TextView android:id="@+id/day3_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/day4_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/day4_sym" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" />
            <TextView android:id="@+id/day4_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
